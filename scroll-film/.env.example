# Copy the ones you need into Vercel → Project → Settings → Environment Variables (and .env.local for `npm run dev`).
# Everything is optional: with nothing set the site builds and runs as an Erythro demo.

# Canonical / Open Graph / sitemap URL (defaults to SITE_URL in lib/site.ts)
NEXT_PUBLIC_SITE_URL=https://example.erythro.ai

# "Thanks for exploring → WhatsApp" demo card. 0 = off (client handover / client production).
NEXT_PUBLIC_DEMO_NOTICE=1

# Google Analytics 4 — default is the Erythro property; a client's own G-XXXX, or 0 = off. Loaded only in production builds.
NEXT_PUBLIC_GA_ID=
# Meta Pixel — default is the Erythro pixel; a client's own id, or 0 = off.
NEXT_PUBLIC_META_PIXEL_ID=

# Order form → webhook (server-only, never exposed to the browser). Unset = the form shows the WhatsApp fallback.
# n8n: run scripts/deploy-n8n-lead.py, it prints the URL.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
